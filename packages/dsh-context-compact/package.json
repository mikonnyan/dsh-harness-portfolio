{
  "name": "@dsh-external/dsh-context-compact",
  "version": "0.0.1",
  "description": "Surgical context compaction with lossless recall and zero-config native auto-compaction takeover for DeepSeek Harness",
  "private": false,
  "type": "module",
  "author": "mikonnyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikonnyan/dsh-context-compact.git"
  },
  "homepage": "https://github.com/mikonnyan/dsh-context-compact#readme",
  "bugs": {
    "url": "https://github.com/mikonnyan/dsh-context-compact/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context-compaction",
    "agent",
    "llm"
  ],
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-token-meter": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:v5": "node --test test/index.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
